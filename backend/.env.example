# ============================================
# MR.GREEN — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================

# Application
APP_NAME=MR.GREEN
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://mrgreen:mrgreen_dev_password@localhost:5432/mrgreen_db

# AI Provider (gemini or ollama)
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT=60

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TIMEOUT=30

# Ollama (local AI alternative)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# Security
SECRET_KEY=change-me-to-a-random-secret-key

# Agent limits
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300
TOOL_TIMEOUT_SECONDS=60

# Memory
MEMORY_EXTRACTION_ENABLED=true
SHORT_TERM_MEMORY_LIMIT=50

# Logging
LOG_LEVEL=INFO
