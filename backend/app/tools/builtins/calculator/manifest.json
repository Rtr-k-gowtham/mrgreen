{
  "name": "calculator",
  "version": "1.0.0",
  "description": "Perform safe mathematical calculations using an AST-based evaluator",
  "category": "math",
  "permissions": [],
  "risk_level": "low",
  "requires_approval": false,
  "enabled": true,
  "input_schema": {
